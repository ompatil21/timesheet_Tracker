# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# LOCAL: docker-compose up -d, then use:
MONGO_URI=mongodb://127.0.0.1:27017/timesheet-tracker-local
# PRODUCTION: set on hosting platform, never commit the real value

# JWT Configuration — generate a strong random secret (e.g. openssl rand -hex 32)
JWT_SECRET=replace_with_a_long_random_string

# Frontend Configuration (for CORS)
FRONTEND_URL=http://localhost:3000

# API Rate Limiting (in requests per 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Humanforce sync — optional dedicated key for encrypting stored ICS links.
# Falls back to JWT_SECRET if unset. Changing it invalidates saved links
# (set this before deploying so rotating JWT_SECRET doesn't break sync).
# HF_ENCRYPTION_KEY=replace_with_a_long_random_string

# Extra domains allowed for calendar feeds (comma-separated host suffixes).
# humanforce.com / humanforce.com.au / humanforcecloud.com(.au) are always allowed.
# HF_ALLOWED_HOSTS=example-tenant-domain.com

# How often the roster sync polls Humanforce (minutes, min 15, default 15).
# Set higher (e.g. 360 = 6h) if using Railway App Sleeping — frequent outbound
# fetches keep the service awake and burn credit.
# SYNC_INTERVAL_MINUTES=15


# Keep-alive self-ping (stops Render's free tier sleeping after 15 min idle).
# Render sets RENDER_EXTERNAL_URL automatically, so nothing is needed there.
# Set KEEP_ALIVE_URL only to enable it on another host or to test locally.
# KEEP_ALIVE_URL=http://localhost:5000
# KEEP_ALIVE_INTERVAL_MINUTES=10
